    },
    {
      "id": "_scratch_ayc_member_app_grilling_notes_pdf_job_design",
      "label": "Reviewer PDF Job Design",
      "file_type": "rationale",
      "source_file": ".scratch/ayc-member-app/grilling-notes.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Resumable upload straight to private Storage because Vercel's body limit is ~4.5 MB; pdf.js on server canvas (permissive licences, no AGPL MuPDF) in ~25-page batches chained; Vercel Cron every minute restarts stalled jobs."
    },
    {
      "id": "_scratch_ayc_member_app_grilling_notes_per_request_watermark",
      "label": "Per-Request Watermark Stamping (sharp)",
      "file_type": "rationale",
      "source_file": ".scratch/ayc-member-app/grilling-notes.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Pages stamped on every request and access decision runs every time; only browser caches (Cache-Control private, short max-age), no CDN/Storage copy. Revises spec's per-Member cached stamped image."
    },
    {
      "id": "_scratch_ayc_member_app_grilling_notes_topics_editor_decision",
      "label": "Topics Editor per Subject Decision",
      "file_type": "rationale",
      "source_file": ".scratch/ayc-member-app/grilling-notes.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Progress tied to the Topic, never its name; imports match Topics by name so re-importing under an old name creates a new Topic."
    },
    {
      "id": "_scratch_ayc_member_app_grilling_notes_quiz_replace_keeps_scores",
