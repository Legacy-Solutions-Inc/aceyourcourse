      "id": "docs_adr_0007_analytics_posthog",
      "label": "ADR 0007: PostHog analytics, opt-in, reverse-proxied, privacy-first",
      "file_type": "document",
      "source_file": "docs/adr/0007-analytics-posthog.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Analytics must be inert without a key, must not weaken the nonce CSP; same-origin /relay proxy keeps CSP unchanged and dodges ad-blockers."
    },
    {
      "id": "docs_adr_0007_analytics_posthog_relay_proxy",
      "label": "/relay same-origin PostHog reverse proxy",
      "file_type": "concept",
