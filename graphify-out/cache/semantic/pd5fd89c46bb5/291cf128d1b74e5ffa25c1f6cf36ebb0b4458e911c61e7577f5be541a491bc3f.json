      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Must stay in sync in three places: next.config rewrites, client api_host, and middleware matcher exclusion; if middleware intercepts /relay ingestion silently breaks."
    },
